# Copy to container/.env and fill in. The site is served at SUBDOMAIN.DOMAIN.
DOMAIN=example.com
SUBDOMAIN=spacechan
APP_URL=https://spacechan.example.com
APP_KEY=
DESEC_TOKEN=
# The network interface whose IP goes into the A record (wlan0 or eth0 on a Pi).
LAN_INTERFACE=wlan0

# Only allow sign-ups from this email domain (empty = anyone).
AUTH_ALLOWED_EMAIL_DOMAIN=student.harbour.space

# SMTP account for the verification and password reset emails,
# e.g. Gmail: smtp.gmail.com, port 587, your address and an app password.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=spacechan
