{
	frankenphp

	# Host networking would expose the admin API on the host's localhost:2019.
	admin off

	# Keeps the A record of the site pointed at this machine's local IP.
	dynamic_dns {
		provider desec {
			token {env.DESEC_TOKEN}
		}
		domains {
			{$DOMAIN} {$SUBDOMAIN}
		}
		ip_source interface {$LAN_INTERFACE}
		versions ipv4
		ttl 60s
		check_interval 1m
	}
}

{$SUBDOMAIN}.{$DOMAIN} {
	tls {
		dns desec {
			token {env.DESEC_TOKEN}
		}
	}

	# HTTPS only, no guessing file types, no framing by other sites, no PHP version
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		-X-Powered-By
	}

	root * /app/public
	encode zstd gzip
	php_server
}
