{
	frankenphp

	# Unprivileged ports, so the container needs no capabilities.
	# The host maps 80 -> 8080 and 443 -> 8443.
	http_port 8080
	https_port 8443

	# No HTTP/3: it would advertise port 8443 to browsers.
	servers {
		protocols h1 h2
	}
}

# Our own redirect, because Caddy's automatic one would point at :8443.
http://{$SERVER_NAME} {
	redir https://{host}{uri} permanent
}

https://{$SERVER_NAME} {
	tls {
		dns desec {
			token {env.DESEC_TOKEN}
		}
	}

	root * /app/public
	encode zstd gzip
	php_server
}
